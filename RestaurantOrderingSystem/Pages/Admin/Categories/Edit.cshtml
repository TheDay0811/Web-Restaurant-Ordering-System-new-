@page "{id:int}"
@model RestaurantOrderingSystem.Pages.Admin.Categories.EditModel
@{
    ViewData["Title"] = "Sửa danh mục";
}

<h1 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2 mb-lg">
    <span class="material-symbols-outlined text-primary text-[32px]">edit</span>
    Sửa danh mục
</h1>

<div class="max-w-xl bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.06)] p-lg">
    <form method="post" class="flex flex-col gap-md">
        <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>
        <input type="hidden" asp-for="Category.CategoryId" />
        <div>
            <label asp-for="Category.Name" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
            <input asp-for="Category.Name"
                   class="w-full px-3 py-2.5 rounded border border-outline-variant bg-surface-container-lowest font-body-lg text-body-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
            <span asp-validation-for="Category.Name" class="text-error font-body-sm text-body-sm"></span>
        </div>
        <div>
            <label asp-for="Category.Description" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
            <textarea asp-for="Category.Description" rows="3"
                      class="w-full px-3 py-2.5 rounded border border-outline-variant bg-surface-container-lowest font-body-lg text-body-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"></textarea>
        </div>
        <div class="flex gap-2 pt-xs">
            <button type="submit" class="px-5 py-2.5 rounded font-label-md text-label-md text-white bg-primary hover:bg-primary-container transition-colors">Cập nhật</button>
            <a asp-page="Index" class="px-5 py-2.5 rounded font-label-md text-label-md text-on-surface border border-outline-variant hover:bg-surface-container transition-colors">Hủy</a>
        </div>
    </form>
</div>
