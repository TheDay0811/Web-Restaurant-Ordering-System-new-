@page
@model RestaurantOrderingSystem.Pages.Admin.Dishes.IndexModel
@{
    ViewData["Title"] = "Quản lý món ăn";
}

<div class="flex items-center justify-between mb-lg gap-md flex-wrap">
    <h1 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2">
        <span class="material-symbols-outlined text-primary text-[32px]">restaurant_menu</span>
        Quản lý món ăn
    </h1>
    <a asp-page="Create"
       class="inline-flex items-center gap-1 px-4 py-2 rounded font-label-md text-label-md text-white bg-primary hover:bg-primary-container transition-colors">
        <span class="material-symbols-outlined text-[18px]">add</span>
        Thêm món ăn
    </a>
</div>

@if (!Model.DishList.Any())
{
    <p class="font-body-lg text-body-lg text-on-surface-variant">Chưa có món ăn nào.</p>
}
else
{
    <div class="overflow-x-auto rounded-lg border border-outline-variant bg-surface-container-lowest shadow-[0px_2px_10px_rgba(0,0,0,0.04)]">
        <table class="w-full text-left border-collapse">
            <thead class="bg-primary text-white">
                <tr>
                    <th class="px-4 py-3 font-label-md text-label-md">Ảnh</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Tên món</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Danh mục</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Giá</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Trạng thái</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var item in Model.DishList)
                {
                    <tr class="hover:bg-surface-container transition-colors">
                        <td class="px-4 py-3">
                            <img class="w-[60px] h-[60px] object-cover rounded"
                                 src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://res.cloudinary.com/demo/image/upload/w_100,h_100,c_fill/sample.jpg" : item.ImageUrl)"
                                 alt="@item.Name" />
                        </td>
                        <td class="px-4 py-3 font-body-lg text-body-lg text-on-surface">@item.Name</td>
                        <td class="px-4 py-3 font-body-lg text-body-lg text-on-surface-variant">@item.Category?.Name</td>
                        <td class="px-4 py-3 font-title-md text-title-md text-secondary font-bold">@item.Price.ToString("N0") đ</td>
                        <td class="px-4 py-3">
                            @if (item.IsAvailable)
                            {
                                <span class="inline-block px-3 py-1 rounded-full font-body-sm text-body-sm bg-tertiary-fixed text-on-tertiary-fixed-variant">Đang phục vụ</span>
                            }
                            else
                            {
                                <span class="inline-block px-3 py-1 rounded-full font-body-sm text-body-sm bg-surface-variant text-on-surface-variant">Ngừng phục vụ</span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex gap-2">
                                <a asp-page="Edit" asp-route-id="@item.DishId"
                                   class="px-3 py-1.5 rounded font-label-md text-label-md text-white bg-primary hover:bg-primary-container transition-colors">Sửa</a>
                                <a asp-page="Delete" asp-route-id="@item.DishId"
                                   class="px-3 py-1.5 rounded font-label-md text-label-md text-error border border-error hover:bg-error-container transition-colors">Xóa</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
