@page
@model RestaurantOrderingSystem.Pages.Admin.Dishes.CreateModel
@{
    ViewData["Title"] = "Thêm món ăn";
}

<h1 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2 mb-lg">
    <span class="material-symbols-outlined text-primary text-[32px]">add_circle</span>
    Thêm món ăn mới
</h1>

<div class="max-w-2xl bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.06)] p-lg">
    <form method="post" class="flex flex-col gap-md">
        <div asp-validation-summary="ModelOnly" class="text-error font-body-sm text-body-sm"></div>

        <div>
            <label asp-for="Dish.Name" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
            <input asp-for="Dish.Name"
                   class="w-full px-3 py-2.5 rounded border border-outline-variant bg-surface-container-lowest font-body-lg text-body-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
            <span asp-validation-for="Dish.Name" class="text-error font-body-sm text-body-sm"></span>
        </div>

        <div>
            <label asp-for="Dish.Description" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
            <textarea asp-for="Dish.Description" rows="3"
                      class="w-full px-3 py-2.5 rounded border border-outline-variant bg-surface-container-lowest font-body-lg text-body-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors"></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
            <div>
                <label asp-for="Dish.Price" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
                <input asp-for="Dish.Price"
                       class="w-full px-3 py-2.5 rounded border border-outline-variant bg-surface-container-lowest font-body-lg text-body-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
                <span asp-validation-for="Dish.Price" class="text-error font-body-sm text-body-sm"></span>
            </div>
            <div>
                <label asp-for="Dish.CategoryId" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
                <select asp-for="Dish.CategoryId" asp-items="Model.CategoryOptions"
                        class="w-full px-3 py-2.5 rounded border border-outline-variant bg-surface-container-lowest font-body-lg text-body-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors">
                    <option value="">-- Chọn danh mục --</option>
                </select>
                <span asp-validation-for="Dish.CategoryId" class="text-error font-body-sm text-body-sm"></span>
            </div>
        </div>

        <div>
            @* Khong upload anh tu may len server nua - chi dan link anh da co san
               (vi du: upload anh len Cloudinary bang tay, roi copy link "Secure URL"
               dan vao o nay) *@
            <label asp-for="Dish.ImageUrl" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
            <input asp-for="Dish.ImageUrl" placeholder="https://res.cloudinary.com/..."
                   class="w-full px-3 py-2.5 rounded border border-outline-variant bg-surface-container-lowest font-body-lg text-body-lg text-on-surface placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
        </div>

        <label class="flex items-center gap-2 font-body-sm text-body-sm text-on-surface cursor-pointer select-none">
            <input asp-for="Dish.IsAvailable" class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary/30" />
            <span>Đang phục vụ</span>
        </label>

        <div class="flex gap-2 pt-xs">
            <button type="submit" class="px-5 py-2.5 rounded font-label-md text-label-md text-white bg-primary hover:bg-primary-container transition-colors">Lưu</button>
            <a asp-page="Index" class="px-5 py-2.5 rounded font-label-md text-label-md text-on-surface border border-outline-variant hover:bg-surface-container transition-colors">Hủy</a>
        </div>
    </form>
</div>
