@{

    string fullName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "Bếp";
}
<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Màn hình Bếp</title>

    @* ===== Dùng chung Design system "Academic Hospitality" với _Layout.cshtml (trang Home) ===== *@
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        colors: {
        "inverse-on-surface": "#f0f1f2", "on-primary-container": "#8aa4ff", "on-background": "#191c1d",
        "tertiary-fixed-dim": "#7adaa1", "on-error-container": "#93000a", "on-secondary": "#ffffff",
        "surface": "#f8f9fa", "on-primary": "#ffffff", "tertiary-container": "#004729",
        "on-tertiary-fixed": "#002110", "on-secondary-fixed-variant": "#6e3900", "tertiary": "#002e19",
        "surface-tint": "#3557bc", "on-surface": "#191c1d", "surface-variant": "#e1e3e4",
        "surface-container-lowest": "#ffffff", "primary-fixed-dim": "#b5c4ff", "surface-container-low": "#f3f4f5",
        "inverse-primary": "#b5c4ff", "on-surface-variant": "#444653", "on-secondary-fixed": "#2f1500",
        "surface-container-high": "#e7e8e9", "outline": "#747684", "primary": "#002068",
        "primary-fixed": "#dce1ff", "surface-bright": "#f8f9fa", "on-tertiary-fixed-variant": "#005230",
        "on-secondary-container": "#713b00", "secondary-fixed-dim": "#ffb77d", "background": "#f8f9fa",
        "surface-container": "#edeeef", "surface-dim": "#d9dadb", "primary-container": "#003399",
        "surface-container-highest": "#e1e3e4", "secondary-fixed": "#ffdcc3", "on-tertiary-container": "#5aba84",
        "inverse-surface": "#2e3132", "on-tertiary": "#ffffff", "outline-variant": "#c4c5d5",
        "on-primary-fixed-variant": "#153ea3", "on-error": "#ffffff", "error": "#ba1a1a",
        "secondary-container": "#ffa454", "on-primary-fixed": "#00164e", "error-container": "#ffdad6",
        "tertiary-fixed": "#95f7bb", "secondary": "#904d00"
        },
        borderRadius: { DEFAULT: "0.125rem", lg: "0.25rem", xl: "0.5rem", full: "0.75rem" },
        spacing: { xs: "4px", lg: "48px", gutter: "24px", "margin-mobile": "16px", md: "24px", "margin-desktop": "64px", sm: "12px", base: "8px" },
        fontFamily: {
        "headline-lg": ["Inter"], "body-lg": ["Inter"], "display-lg": ["Inter"],
        "title-md": ["Inter"], "label-md": ["Inter"], "headline-lg-mobile": ["Inter"], "body-sm": ["Inter"],
        mono: ["Roboto Mono", "monospace"]
        },
        fontSize: {
        "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "600" }],
        "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
        "display-lg": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "700" }],
        "headline-lg-mobile": ["24px", { lineHeight: "32px", fontWeight: "600" }],
        "title-md": ["20px", { lineHeight: "28px", fontWeight: "600" }],
        "label-md": ["12px", { lineHeight: "16px", fontWeight: "600", letterSpacing: "0.05em" }],
        "body-sm": ["14px", { lineHeight: "20px", fontWeight: "400" }]
        }
        }
        }
        }
    </script>
    <style>
        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
        -webkit-tap-highlight-color: transparent;
        }
    </style>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-background text-on-background font-body-lg antialiased select-none">

    @* ===== Thanh tiêu đề Bếp - cùng phong cách header của trang Home (bg-primary, chữ trắng) ===== *@
    <header class="sticky top-0 z-50 bg-primary text-on-primary shadow-sm border-b border-outline-variant">
        <div class="flex items-center justify-between px-margin-mobile md:px-margin-desktop h-20">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-secondary-container text-[36px]">soup_kitchen</span>
                <div>
                    <p class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg font-bold text-white leading-tight">MÀN HÌNH BẾP</p>
                    <p class="font-body-sm text-body-sm text-primary-fixed leading-tight">Nhà Hàng HUFLIT</p>
                </div>
            </div>

            <div class="flex items-center gap-4 md:gap-8">
                <div class="text-right hidden sm:block">
                    <p id="kitchen-clock" class="font-mono font-bold text-2xl md:text-3xl text-white leading-tight"></p>
                    <p id="kitchen-date" class="font-body-sm text-body-sm text-primary-fixed leading-tight"></p>
                </div>

                <div class="flex items-center gap-2 pl-4 md:pl-6 border-l border-white/20">
                    <span class="material-symbols-outlined text-primary-fixed">badge</span>
                    <span class="hidden md:inline font-label-md text-label-md text-white">@fullName</span>
                    <a asp-controller="Account" asp-action="Logout"
                       class="ml-2 flex items-center gap-1 px-3 py-2 rounded border border-white text-white hover:bg-white/10 font-label-md text-label-md transition-colors duration-150"
                       title="Đăng xuất">
                        <span class="material-symbols-outlined text-[20px]">logout</span>
                        <span class="hidden lg:inline">Đăng xuất</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    @* ===== Thông báo TempData (nếu có) ===== *@
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="w-full px-margin-mobile md:px-margin-desktop pt-md">
            @if (TempData["Success"] != null)
            {
                <div class="mb-md px-4 py-3 rounded-lg bg-tertiary-fixed text-on-tertiary-fixed-variant font-body-sm text-body-sm">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mb-md px-4 py-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm">@TempData["Error"]</div>
            }
        </div>
    }

    @* ===== Nội dung chính - nền trắng như trang Home, khoảng trắng rộng cho dễ bấm trên tablet ===== *@
    <main class="flex-grow w-full px-margin-mobile md:px-margin-desktop py-lg" role="main">
        @RenderBody()
    </main>

    @* ===== Footer - cùng phong cách với trang Home ===== *@
    <footer class="bg-surface-container-highest text-on-surface-variant font-body-sm text-body-sm w-full py-base px-margin-mobile md:px-margin-desktop flex flex-col md:flex-row justify-between items-center border-t border-outline-variant gap-md">
        <span class="font-title-md text-title-md font-bold text-primary">Nhà Hàng HUFLIT</span>
        <span>Kitchen Display System &middot; <span id="kitchen-footer-clock" class="font-mono"></span></span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Đồng hồ trực tiếp, tự cập nhật mỗi giây - giúp bếp ước lượng thời gian chờ
        // của từng đơn mà không cần rời mắt khỏi màn hình để xem giờ trên thiết bị khác
        function updateKitchenClock() {
        const now = new Date();
        const timeText = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const dateText = now.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });

        const clockEl = document.getElementById('kitchen-clock');
        const dateEl = document.getElementById('kitchen-date');
        const footerClockEl = document.getElementById('kitchen-footer-clock');

        if (clockEl) clockEl.textContent = timeText;
        if (dateEl) dateEl.textContent = dateText;
        if (footerClockEl) footerClockEl.textContent = timeText;
        }
        updateKitchenClock();
        setInterval(updateKitchenClock, 1000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
