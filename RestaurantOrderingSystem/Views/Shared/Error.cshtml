@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}
<style>
    .error-box {
        background-color: white;
        border-left: 6px solid orange;
        padding: 1.5rem;
        border-radius: 6px;
    }
</style>

<div class="error-box">
    <h2 class="text-danger">Rất tiếc, đã có lỗi xảy ra.</h2>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-restaurant-dark">Về trang chủ</a>
</div>
