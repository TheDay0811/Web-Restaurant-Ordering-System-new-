@model CheckoutViewModel
@{
    ViewData["Title"] = "Đặt món";
}

<h1 class="font-headline-lg text-headline-lg text-on-background mb-lg">Thông tin đặt món</h1>

<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
    <div class="md:col-span-7">
        <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-md">
            <form asp-controller="Order" asp-action="Checkout" method="post" class="flex flex-col gap-md">
                <div asp-validation-summary="ModelOnly" class="font-body-sm text-body-sm text-error"></div>

                <div>
                    <label asp-for="CustomerName" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
                    <input asp-for="CustomerName" placeholder="Nhập họ tên..."
                           class="w-full rounded border border-outline-variant px-3 py-2 focus:outline-none focus:border-primary" />
                    <span asp-validation-for="CustomerName" class="font-body-sm text-body-sm text-error"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
                    <input asp-for="PhoneNumber" placeholder="Nhập số điện thoại..."
                           class="w-full rounded border border-outline-variant px-3 py-2 focus:outline-none focus:border-primary" />
                    <span asp-validation-for="PhoneNumber" class="font-body-sm text-body-sm text-error"></span>
                </div>
                <div>
                    <label asp-for="TableNumber" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
                    <select asp-for="TableNumber" asp-items="ViewBag.TableOptions"
                            class="w-full rounded border border-outline-variant px-3 py-2 bg-surface-container-lowest focus:outline-none focus:border-primary">
                    </select>
                </div>
                <div>
                    <label asp-for="Note" class="block font-label-md text-label-md text-on-surface mb-xs"></label>
                    <textarea asp-for="Note" rows="3" placeholder="Ghi chú thêm cho nhà hàng..."
                              class="w-full rounded border border-outline-variant px-3 py-2 focus:outline-none focus:border-primary"></textarea>
                </div>

                <div class="flex gap-sm">
                    <button type="submit" class="px-4 py-2 rounded font-label-md text-label-md bg-secondary text-white hover:bg-secondary/90 transition-colors">
                        Xác nhận đặt món
                    </button>
                    <a asp-controller="Cart" asp-action="Index"
                       class="px-4 py-2 rounded font-label-md text-label-md border border-outline text-on-surface-variant hover:bg-surface-variant transition-colors">
                        Quay lại giỏ hàng
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="md:col-span-5">
        <div class="bg-surface-container-lowest border border-primary-container rounded-lg p-md">
            <h2 class="font-title-md text-title-md text-primary mb-sm">Tóm tắt đơn hàng</h2>
            <ul class="flex flex-col divide-y divide-outline-variant mb-md">
                @foreach (var item in Model.Items)
                {
                    <li class="flex justify-between py-2 font-body-sm text-body-sm text-on-surface">
                        <span>@item.DishName x @item.Quantity</span>
                        <span>@item.SubTotal.ToString("N0") đ</span>
                    </li>
                }
            </ul>
            <div class="flex justify-between font-title-md text-title-md text-secondary font-bold border-t border-outline-variant pt-sm">
                <span>Tổng cộng:</span>
                <span>@Model.GrandTotal.ToString("N0") đ</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
