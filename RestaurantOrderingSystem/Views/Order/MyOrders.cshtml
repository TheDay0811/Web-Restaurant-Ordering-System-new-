@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}
<style>
    .my-orders-table th {
        background-color: darkblue;
        color: white;
    }

    .total-cell {
        color: orange;
        font-weight: 700;
    }

    .status-badge {
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        color: white;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .status-Pending { background-color: dimgray; }
    .status-Confirmed { background-color: steelblue; }
    .status-Paid { background-color: seagreen; }
    .status-Cancelled { background-color: firebrick; }
</style>

<h2 class="mb-3" style="color:darkblue;">Đơn hàng của tôi</h2>

@if (!Model.Any())
{
    <p>Bạn chưa đặt món nào. <a asp-controller="Menu" asp-action="Index">Xem thực đơn</a> để đặt món nhé.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered align-middle my-orders-table">
            <thead>
                <tr>
                    <th>Mã HĐ</th>
                    <th>Ngày đặt</th>
                    <th>Bàn</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderCode</td>
                        <td>@order.OrderDate.ToString("HH:mm dd/MM/yyyy")</td>
                        <td>@(string.IsNullOrEmpty(order.TableNumber) ? "Mang về" : order.TableNumber)</td>
                        <td class="total-cell">@order.TotalAmount.ToString("N0") đ</td>
                        <td><span class="status-badge status-@order.Status">@order.Status</span></td>
                        <td>
                            <a asp-controller="Order" asp-action="Invoice" asp-route-id="@order.OrderId" class="btn btn-sm btn-restaurant-primary">Xem hóa đơn</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
