@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";

    string BadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "bg-secondary-container/40 text-on-secondary-container",
        OrderStatus.Confirmed => "bg-primary-fixed text-on-primary-fixed-variant",
        OrderStatus.Paid => "bg-tertiary-fixed text-on-tertiary-fixed-variant",
        OrderStatus.Cancelled => "bg-error-container text-on-error-container",
        _ => "bg-surface-variant text-on-surface-variant"
    };
}

<h1 class="font-headline-lg text-headline-lg text-on-background mb-md">Đơn hàng của tôi</h1>

@if (!Model.Any())
{
    <p class="font-body-lg text-body-lg text-on-surface-variant">
        Bạn chưa đặt món nào.
        <a class="text-primary hover:underline" asp-controller="Menu" asp-action="Index">Xem thực đơn</a> để đặt món nhé.
    </p>
}
else
{
    <div class="overflow-x-auto rounded-lg border border-outline-variant">
        <table class="w-full bg-surface-container-lowest">
            <thead>
                <tr class="bg-surface-container-low">
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-left px-md py-sm">Mã HĐ</th>
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-left px-md py-sm">Ngày đặt</th>
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-left px-md py-sm">Bàn</th>
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-left px-md py-sm">Tổng tiền</th>
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-left px-md py-sm">Trạng thái</th>
                    <th class="px-md py-sm"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr class="border-t border-outline-variant hover:bg-primary-fixed/20 transition-colors">
                        <td class="px-md py-sm font-body-sm text-body-sm text-on-surface">@order.OrderCode</td>
                        <td class="px-md py-sm font-body-sm text-body-sm text-on-surface">@order.OrderDate.ToString("HH:mm dd/MM/yyyy")</td>
                        <td class="px-md py-sm font-body-sm text-body-sm text-on-surface">@(string.IsNullOrEmpty(order.TableNumber) ? "Mang về" : order.TableNumber)</td>
                        <td class="px-md py-sm font-body-sm text-body-sm text-secondary font-bold">@order.TotalAmount.ToString("N0") đ</td>
                        <td class="px-md py-sm">
                            <span class="inline-block px-2 py-1 rounded-full font-label-md text-label-md uppercase @BadgeClass(order.Status)">@order.Status</span>
                        </td>
                        <td class="px-md py-sm">
                            <a asp-controller="Order" asp-action="Invoice" asp-route-id="@order.OrderId"
                               class="px-3 py-1 rounded font-label-md text-label-md bg-primary text-white hover:bg-primary-container transition-colors">
                                Xem hóa đơn
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
