@model IEnumerable<Order>
@{
    ViewData["Title"] = "Quản lý hóa đơn";

    string BadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "bg-secondary-container/40 text-on-secondary-container",
        OrderStatus.Confirmed => "bg-primary-fixed text-on-primary-fixed-variant",
        OrderStatus.Paid => "bg-tertiary-fixed text-on-tertiary-fixed-variant",
        OrderStatus.Cancelled => "bg-error-container text-on-error-container",
        _ => "bg-surface-variant text-on-surface-variant"
    };
}

<h1 class="font-headline-lg text-headline-lg text-primary flex items-center gap-2 mb-lg">
    <span class="material-symbols-outlined text-primary text-[32px]">receipt_long</span>
    Danh sách hóa đơn
</h1>

@if (!Model.Any())
{
    <p class="font-body-lg text-body-lg text-on-surface-variant">Chưa có hóa đơn nào.</p>
}
else
{
    <div class="overflow-x-auto rounded-lg border border-outline-variant bg-surface-container-lowest shadow-[0px_2px_10px_rgba(0,0,0,0.04)]">
        <table class="w-full text-left border-collapse">
            <thead class="bg-primary text-white">
                <tr>
                    <th class="px-4 py-3 font-label-md text-label-md">Mã HĐ</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Khách hàng</th>
                    <th class="px-4 py-3 font-label-md text-label-md">SĐT</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Bàn</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Ngày đặt</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Tổng tiền</th>
                    <th class="px-4 py-3 font-label-md text-label-md">Trạng thái</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var order in Model)
                {
                    <tr class="hover:bg-surface-container transition-colors">
                        <td class="px-4 py-3 font-body-lg text-body-lg text-on-surface font-semibold">@order.OrderCode</td>
                        <td class="px-4 py-3 font-body-lg text-body-lg text-on-surface">@order.CustomerName</td>
                        <td class="px-4 py-3 font-body-lg text-body-lg text-on-surface-variant">@order.PhoneNumber</td>
                        <td class="px-4 py-3 font-body-lg text-body-lg text-on-surface-variant">@(string.IsNullOrEmpty(order.TableNumber) ? "Mang về" : order.TableNumber)</td>
                        <td class="px-4 py-3 font-body-lg text-body-lg text-on-surface-variant">@order.OrderDate.ToString("HH:mm dd/MM/yyyy")</td>
                        <td class="px-4 py-3 font-title-md text-title-md text-secondary font-bold">@order.TotalAmount.ToString("N0") đ</td>
                        <td class="px-4 py-3">
                            @if (order.Status == OrderStatus.Cancelled && !string.IsNullOrEmpty(order.CancelReason))
                            {
                                <p class="mb-2 px-2 py-1 rounded bg-error-container text-on-error-container font-body-sm text-body-sm max-w-[220px]">
                                    <span class="material-symbols-outlined text-[14px] align-middle">info</span>
                                    Lý do hủy: @order.CancelReason
                                </p>
                            }
                            <span class="inline-block px-2 py-1 rounded-full font-label-md text-label-md uppercase @BadgeClass(order.Status)">@order.Status</span>
                        </td>
                        <td class="px-4 py-3">
                            @{
                                bool daThanhToan = order.Status == OrderStatus.Paid || order.Status == OrderStatus.Cancelled;
                            }
                            <a asp-controller="Order" asp-action="Invoice" asp-route-id="@order.OrderId"
                               class="px-3 py-1.5 rounded font-label-md text-label-md text-white transition-colors whitespace-nowrap @(daThanhToan ? "bg-secondary-container hover:bg-secondary-container/90" : "bg-secondary hover:bg-secondary/90")">
                                @(daThanhToan ? "Xem hóa đơn" : "Thanh toán")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
