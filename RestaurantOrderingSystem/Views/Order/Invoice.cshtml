@model Order
@{
    ViewData["Title"] = "Hóa đơn " + Model.OrderCode;

    string BadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "bg-secondary-container/40 text-on-secondary-container",
        OrderStatus.Confirmed => "bg-primary-fixed text-on-primary-fixed-variant",
        OrderStatus.Paid => "bg-tertiary-fixed text-on-tertiary-fixed-variant",
        OrderStatus.Cancelled => "bg-error-container text-on-error-container",
        _ => "bg-surface-variant text-on-surface-variant"
    };
}

<div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-lg max-w-3xl mx-auto">
    <div class="flex justify-between items-start flex-wrap gap-md border-b-2 border-secondary-container pb-md mb-md">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-background mb-xs">Nhà Hàng HUFLIT</h1>
            <div class="font-body-sm text-body-sm text-on-surface-variant">Hóa đơn đặt món</div>
        </div>
        <div class="text-right">
            <div class="font-title-md text-title-md text-secondary font-bold">Mã hóa đơn: @Model.OrderCode</div>
            <div class="font-body-sm text-body-sm text-on-surface-variant">Ngày đặt: @Model.OrderDate.ToString("HH:mm dd/MM/yyyy")</div>
            <span class="inline-block mt-xs px-2 py-1 rounded-full font-label-md text-label-md uppercase @BadgeClass(Model.Status)">@Model.Status</span>
        </div>
    </div>

    @if (Model.Status == OrderStatus.Cancelled && !string.IsNullOrEmpty(Model.CancelReason))
    {
        <div class="mb-md px-4 py-3 rounded-lg bg-error-container text-on-error-container font-body-sm text-body-sm flex items-start gap-2">
            <span class="material-symbols-outlined text-[18px] mt-[1px]">info</span>
            <span><strong>Lý do hủy đơn:</strong> @Model.CancelReason</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-md mb-md font-body-sm text-body-sm text-on-surface">
        <div>
            <strong>Khách hàng:</strong> @Model.CustomerName<br />
            <strong>Điện thoại:</strong> @Model.PhoneNumber
        </div>
        <div>
            <strong>Số bàn:</strong> @(string.IsNullOrEmpty(Model.TableNumber) ? "Mang về" : Model.TableNumber)<br />
            <strong>Ghi chú:</strong> @(string.IsNullOrEmpty(Model.Note) ? "(không có)" : Model.Note)
        </div>
    </div>

    <div class="overflow-x-auto rounded-lg border border-outline-variant mb-md">
        <table class="w-full">
            <thead>
                <tr class="bg-surface-container-low">
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-left px-md py-sm">Món ăn</th>
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-right px-md py-sm">Đơn giá</th>
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-center px-md py-sm">Số lượng</th>
                    <th class="font-label-md text-label-md uppercase text-on-surface-variant text-right px-md py-sm">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.OrderDetails ?? Enumerable.Empty<OrderDetail>())
                {
                    <tr class="border-t border-outline-variant">
                        <td class="px-md py-sm font-body-sm text-body-sm text-on-surface">@detail.DishName</td>
                        <td class="px-md py-sm font-body-sm text-body-sm text-on-surface text-right">@detail.UnitPrice.ToString("N0") đ</td>
                        <td class="px-md py-sm font-body-sm text-body-sm text-on-surface text-center">@detail.Quantity</td>
                        <td class="px-md py-sm font-body-sm text-body-sm text-on-surface text-right">@detail.SubTotal.ToString("N0") đ</td>
                    </tr>
                }
                <tr class="border-t border-outline-variant">
                    <td colspan="3" class="px-md py-sm text-right font-title-md text-title-md text-secondary font-bold">Tổng cộng:</td>
                    <td class="px-md py-sm text-right font-title-md text-title-md text-secondary font-bold">@Model.TotalAmount.ToString("N0") đ</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-md mb-md">
        @if (ViewBag.VietQrUrl != null)
        {
            <div class="flex flex-col items-center gap-2 p-md rounded-lg border border-outline-variant bg-surface-container-lowest">
                <span class="font-label-md text-label-md text-on-surface-variant uppercase">Quét mã để thanh toán</span>
                <img src="@ViewBag.VietQrUrl" alt="QR thanh toán VietQR" class="w-full max-w-[260px] aspect-square object-contain" />
                <div class="font-body-sm text-body-sm text-on-surface text-center">
                    <div><strong>@ViewBag.BankName</strong> - @ViewBag.AccountNumber</div>
                    <div>Chủ TK: @ViewBag.AccountName</div>
                    <div class="text-secondary font-bold mt-1">@Model.TotalAmount.ToString("N0") đ</div>
                </div>
            </div>
        }
        <div class="flex flex-col items-center gap-2 p-md rounded-lg border border-outline-variant bg-surface-container-lowest">
            <span class="font-label-md text-label-md text-on-surface-variant uppercase">Mã QR hóa đơn</span>
            <img src="data:image/png;base64,@ViewBag.InvoiceQrBase64" alt="QR hóa đơn" class="w-full max-w-[260px] aspect-square object-contain" />
            <span class="font-body-sm text-body-sm text-on-surface-variant text-center">Quét để xem lại chi tiết hóa đơn này bất cứ lúc nào</span>
        </div>
    </div>

    @if (User.IsInRole(UserRole.Admin) && Model.Status != OrderStatus.Paid && Model.Status != OrderStatus.Cancelled)
    {
        <form asp-controller="Order" asp-action="MarkPaid" asp-route-id="@Model.OrderId" method="post" class="mb-md">
            <button type="submit"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 rounded font-label-lg text-label-lg text-white bg-tertiary hover:bg-tertiary/90 transition-colors">
                <span class="material-symbols-outlined text-[20px]">check_circle</span>
                Xác nhận đã thanh toán
            </button>
        </form>
    }

    @if (!User.IsInRole(UserRole.Admin))
    {
        <a asp-controller="Menu" asp-action="Index"
           class="inline-block px-4 py-2 rounded font-label-md text-label-md bg-secondary text-white hover:bg-secondary/90 transition-colors">
            Đặt thêm món khác
        </a>
    }
</div>
