@model IEnumerable<Dish>
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Banner -->
<div class="bg-primary rounded-lg text-center py-lg px-md mb-lg">
    <h1 class="font-display-lg text-display-lg text-white mb-xs">Chào mừng đến với Nhà Hàng HUFLIT</h1>
    <p class="font-body-lg text-body-lg text-primary-fixed mb-md">Đặt món ngon, giao nhanh, thanh toán tiện lợi ngay tại bàn.</p>
    <a asp-controller="Menu" asp-action="Index"
       class="inline-block px-6 py-3 rounded font-label-md text-label-md bg-secondary text-white hover:bg-secondary/90 transition-colors">
        Xem thực đơn ngay
    </a>
</div>

<h2 class="font-headline-lg text-headline-lg text-on-background mb-md border-b-2 border-secondary-container inline-block pb-1">Món ăn nổi bật</h2>

@if (!Model.Any())
{
    <p class="font-body-lg text-body-lg text-on-surface-variant mt-md">Hiện chưa có món ăn nào. Vui lòng quay lại sau.</p>
}
else
{
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-gutter mt-md">
        @foreach (var dish in Model)
        {
            <div class="bg-surface-container-lowest rounded-lg border border-outline-variant overflow-hidden hover:shadow-[0px_4px_12px_rgba(0,0,0,0.05)] transition-shadow duration-300 flex flex-col group">
                <div class="relative h-32 w-full overflow-hidden">
                    <img class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                         src="@(string.IsNullOrEmpty(dish.ImageUrl) ? "https://res.cloudinary.com/demo/image/upload/w_400,h_300,c_fill/sample.jpg" : dish.ImageUrl)"
                         alt="@dish.Name" />
                </div>
                <div class="p-sm flex flex-col flex-grow">
                    <h3 class="font-title-md text-title-md text-on-surface mb-xs line-clamp-1">@dish.Name</h3>
                    <div class="font-title-md text-title-md text-secondary font-bold mb-sm">@dish.Price.ToString("N0") đ</div>
                    <a asp-controller="Menu" asp-action="Details" asp-route-id="@dish.DishId"
                       class="mt-auto text-center px-3 py-2 rounded font-label-md text-label-md bg-primary text-white hover:bg-primary-container transition-colors">
                        Xem chi tiết
                    </a>
                </div>
            </div>
        }
    </div>
}
