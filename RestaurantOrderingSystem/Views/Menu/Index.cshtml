@model IEnumerable<Dish>
@{
    ViewData["Title"] = "Thực đơn";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
    string? searchTerm = ViewBag.SearchTerm;
}

<div class="mb-lg flex flex-col gap-md">
    <div>
        <h1 class="font-display-lg text-display-lg text-on-background mb-xs">Thực đơn</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant">Khám phá các món ăn hấp dẫn từ Nhà Hàng HUFLIT.</p>
    </div>

    <!-- Thanh tim kiem theo ten mon - dung GET nen co the bookmark/share link duoc -->
    <form asp-action="Index" method="get" class="flex gap-sm">
        @if (selectedCategoryId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@selectedCategoryId" />
        }
        <input type="text" name="searchTerm" value="@searchTerm"
               placeholder="Tìm món ăn theo tên..."
               class="flex-1 px-4 py-2 rounded-full border border-outline-variant bg-surface text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary" />
        <button type="submit"
                class="px-4 py-2 rounded-full font-label-md text-label-md bg-primary text-white hover:bg-primary-container transition-colors">
            Tìm
        </button>
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <a asp-action="Index" asp-route-categoryId="@selectedCategoryId"
               class="px-4 py-2 rounded-full font-label-md text-label-md bg-surface text-on-surface border border-outline-variant hover:bg-surface-variant transition-colors inline-flex items-center justify-center">
                Xóa
            </a>
        }
    </form>

    <!-- Category Pills -->
    <div class="flex flex-wrap gap-sm">
        <a asp-action="Index"
           class="px-4 py-2 rounded-full font-label-md text-label-md transition-colors @(selectedCategoryId == null ? "bg-primary text-white shadow-sm" : "bg-surface text-on-surface border border-outline-variant hover:bg-surface-variant")">
            Tất cả
        </a>
        @foreach (var c in categories)
        {
            <a asp-action="Index" asp-route-categoryId="@c.CategoryId"
               class="px-4 py-2 rounded-full font-label-md text-label-md transition-colors @(selectedCategoryId == c.CategoryId ? "bg-primary text-white shadow-sm" : "bg-surface text-on-surface border border-outline-variant hover:bg-surface-variant")">
                @c.Name
            </a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <p class="font-body-lg text-body-lg text-on-surface-variant">
        @(!string.IsNullOrWhiteSpace(searchTerm)
            ? $"Không tìm thấy món ăn nào khớp với \"{searchTerm}\"."
            : "Không có món ăn nào trong danh mục này.")
    </p>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
        @foreach (var dish in Model)
        {
            <div class="bg-surface-container-lowest rounded-lg border border-outline-variant overflow-hidden hover:shadow-[0px_4px_12px_rgba(0,0,0,0.05)] transition-shadow duration-300 flex flex-col group">
                <div class="relative h-48 w-full overflow-hidden">
                    <img class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                         src="@(string.IsNullOrEmpty(dish.ImageUrl) ? "https://res.cloudinary.com/demo/image/upload/w_400,h_300,c_fill/sample.jpg" : dish.ImageUrl)"
                         alt="@dish.Name" />
                    @if (!dish.IsAvailable)
                    {
                        <div class="absolute top-sm right-sm bg-surface-container-lowest/90 backdrop-blur-sm px-2 py-1 rounded font-label-md text-label-md text-on-surface-variant font-bold">
                            Ngừng phục vụ
                        </div>
                    }
                    else if (dish.Category != null)
                    {
                        <div class="absolute top-sm right-sm bg-surface-container-lowest/90 backdrop-blur-sm px-2 py-1 rounded font-label-md text-label-md text-primary font-bold">
                            @dish.Category.Name
                        </div>
                    }
                </div>
                <div class="p-md flex flex-col flex-grow">
                    <h3 class="font-title-md text-title-md text-on-surface mb-xs line-clamp-1">@dish.Name</h3>
                    <div class="flex justify-between items-center mt-auto pt-sm">
                        <span class="font-title-md text-title-md text-secondary font-bold">@dish.Price.ToString("N0") đ</span>
                        <a asp-action="Details" asp-route-id="@dish.DishId"
                           class="px-3 py-2 rounded font-label-md text-label-md bg-primary text-white hover:bg-primary-container transition-colors">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}