@model IEnumerable<Order>
@{
    ViewData["Title"] = "Màn hình bếp";

}

@section Scripts {
    <script>
        setTimeout(function () { location.reload(); }, 20000);
    </script>
}

<div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg font-bold text-primary flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary text-[32px]">skillet</span>
        Món cần làm
    </h2>
    <span class="font-body-sm text-body-sm text-on-surface-variant flex items-center gap-1">
        <span class="material-symbols-outlined text-[18px]">autorenew</span>
        Tự làm mới mỗi 20 giây
    </span>
</div>

@if (!Model.Any())
{
    <div class="w-full text-center py-20">
        <span class="material-symbols-outlined text-[64px] text-outline-variant">restaurant</span>
        <p class="text-lg text-on-surface-variant mt-3">Hiện chưa có món nào cần làm 🎉</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
        @foreach (var order in Model)
        {
            double minutesAgo = (DateTime.Now - order.OrderDate).TotalMinutes;
            bool isLate = minutesAgo >= 15;

            <div class="rounded-xl border-2 @(isLate ? "border-error" : "border-outline-variant") bg-surface-container-lowest shadow-md flex flex-col overflow-hidden">
                <div class="flex items-center justify-between px-5 py-4 @(isLate ? "bg-error" : "bg-primary")">
                    <div>
                        <p class="text-xl font-extrabold @(isLate ? "text-white" : "text-secondary-container")">
                            @(string.IsNullOrEmpty(order.TableNumber) ? "Mang về" : "Bàn " + order.TableNumber)
                        </p>
                        <p class="text-sm @(isLate ? "text-white/80" : "text-primary-fixed")">
                            @order.OrderCode
                        </p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm font-bold text-white">
                            @order.OrderDate.ToString("HH:mm")
                        </p>
                        <p class="text-sm font-semibold @(isLate ? "text-white" : "text-primary-fixed")">
                            @(minutesAgo < 1 ? "vừa gửi" : $"{(int)minutesAgo} phút trước")
                        </p>
                    </div>
                </div>

                <div class="px-5 py-4 flex-grow">
                    <ul class="divide-y divide-outline-variant">
                        @foreach (var item in order.OrderDetails ?? new List<OrderDetail>())
                        {
                            <li class="py-3 flex items-center justify-between gap-3">
                                <span class="text-lg text-on-background">@item.DishName</span>
                                <span class="text-xl font-extrabold text-primary whitespace-nowrap">x@item.Quantity</span>
                            </li>
                        }
                    </ul>
                    @if (!string.IsNullOrEmpty(order.Note))
                    {
                        <p class="mt-3 px-3 py-2 rounded-lg bg-surface-container text-on-surface-variant text-sm">
                            <span class="material-symbols-outlined text-[16px] align-middle">edit_note</span>
                            @order.Note
                        </p>
                    }
                </div>

                <form asp-controller="Kitchen" asp-action="MarkDone" asp-route-id="@order.OrderId" method="post" class="p-4 pt-0">
                    <button type="submit" class="w-full py-3 rounded bg-tertiary-container hover:bg-tertiary-container/90 text-white text-base font-bold transition-colors duration-150 flex items-center justify-center gap-2 active:scale-[0.98]">
                        <span class="material-symbols-outlined text-[20px]">check_circle</span>
                        Đã xong
                    </button>
                </form>
            </div>
        }
    </div>
}
