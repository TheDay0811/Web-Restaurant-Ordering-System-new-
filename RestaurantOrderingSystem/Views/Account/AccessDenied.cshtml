@{
    ViewData["Title"] = "Không có quyền truy cập";
}
<style>
    .denied-box {
        max-width: 500px;
        margin: 2rem auto;
        background-color: white;
        border-left: 6px solid orange;
        border-radius: 10px;
        padding: 2rem;
        text-align: center;
    }

    .denied-box h2 {
        color: darkblue;
    }
</style>

<div class="denied-box">
    <h2>🚫 Bạn không có quyền truy cập chức năng này</h2>
    <p>Chức năng này chỉ dành cho một vai trò khác trong hệ thống (Khách hàng hoặc Quản trị viên).</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-restaurant-dark">Về trang chủ</a>
</div>
